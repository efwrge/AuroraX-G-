			end
			local function settle(open)
				if open then
					wrap.AutomaticSize = Enum.AutomaticSize.Y
					wrap.Size = UDim2.new(1, 0, 0, 0)
					wrap.ClipsDescendants = false
				else
					wrap.Size = UDim2.new(1, 0, 0, 0)
					wrap.Visible = false
				end
			end
			head.MouseButton1Click:Connect(function()
				isOpen = not isOpen
				anim = anim + 1
				local my = anim
				local opening = isOpen
				tween(arrow, 0.22, { Rotation = opening and 0 or -90 }, Enum.EasingStyle.Quad)
				task.spawn(function()
					-- AbsoluteSize ekran pikselidir; menu UIScale ile kucultuldugu icin yerel birime cevrilir (yoksa son satir kirpilir)
					local function lh(px) return px / math.max(uiscale.Scale, 0.05) end
					local startH = lh(wrap.AbsoluteSize.Y)
					wrap.AutomaticSize = Enum.AutomaticSize.None
					wrap.ClipsDescendants = true
					if opening then
						wrap.Size = UDim2.new(1, 0, 0, startH)
						wrap.Visible = true
						-- ilk yerlesim/cizim takilmasi animasyonun icine binmesin: bir kare bekle
						RunService.Heartbeat:Wait()
					end
					local dur = opening and 0.28 or 0.22
					local t0 = os.clock()
					while my == anim do
						local a = math.min(1, (os.clock() - t0) / dur)
						local e = 1 - (1 - a) * (1 - a)
						local full = lh(content.AbsoluteSize.Y)
						local h = opening and (startH + (full - startH) * e) or (startH * (1 - e))
						wrap.Size = UDim2.new(1, 0, 0, math.floor(h + 0.5))
						if a >= 1 then break end
						RunService.Heartbeat:Wait()
					end
