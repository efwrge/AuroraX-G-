				return obj
			end

			function Section:AddColorPicker(t, default, cb, customOrder)
				if type(t) == "table" then
					local o = t
					t = o.Name or o.Title or "Color"
					default = o.Default
					cb = o.Callback or o.Cb
					customOrder = o.Order or o.LayoutOrder
				end
				local h, s, v = (default or accent):ToHSV()
				local r = row(40, t, nil, customOrder)
				r.ClipsDescendants = true
				local head = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, AutoButtonColor = false })
				head.Parent = r
				local __trCp = label({ Text = T_(t), Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(14, 0), TextColor3 = T.text })
				__trCp.Parent = head
				regT(__trCp, t)
				local sw = new("Frame", { Size = UDim2.fromOffset(34, 20), Position = UDim2.new(1, -48, 0.5, -10), BackgroundColor3 = Color3.fromHSV(h, s, v), BorderSizePixel = 0 }, { corner(6), stroke(T.line, 1, 0.2) })
				sw.Parent = head
				local satG, valG
				-- doygunluk / parlaklik cubuklari secili tona gore renklenir
				local function tintBars()
					if satG then satG.Color = ColorSequence.new(Color3.fromHSV(h, 0, 1), Color3.fromHSV(h, 1, 1)) end
					if valG then valG.Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(h, s, 1)) end
				end
				local function apply()
					local c = Color3.fromHSV(h, s, v)
					sw.BackgroundColor3 = c
					tintBars()
					if cb then cb(c) end
				end
				local function bar(y, seq, onRel)
					local grad = new("UIGradient", { Color = seq })
					local tr = new("Frame", { Size = UDim2.new(1, -28, 0, 10), Position = UDim2.fromOffset(14, y), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(5), grad })
					local k = new("Frame", { Size = UDim2.fromOffset(6, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(3), stroke(Color3.new(0, 0, 0), 1, 0.4) })
					k.Parent = tr
					tr.Parent = r
					makeDrag(tr, function(rel) k.Position = UDim2.fromScale(rel, 0.5) onRel(rel) end)
					return k, grad
				end
				local hueSeq = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
					ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)), ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
					ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)), ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
					ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
				})
				local hueK = bar(48, hueSeq, function(rel) h = rel apply() end)
				hueK.Position = UDim2.fromScale(h, 0.5)
				local satK
				satK, satG = bar(70, ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 0, 0)), function(rel) s = rel apply() end)
				satK.Position = UDim2.fromScale(s, 0.5)
				local valK
				valK, valG = bar(92, ColorSequence.new(Color3.new(0, 0, 0), Color3.new(1, 1, 1)), function(rel) v = rel apply() end)
				valK.Position = UDim2.fromScale(v, 0.5)
				tintBars()
				local open = false
				head.MouseButton1Click:Connect(function()
					open = not open
					tween(r, 0.3, { Size = UDim2.new(1, 0, 0, open and 120 or 40) })
				end)
				local obj = {
					Frame = r,
					SetOrder = function(n) if type(n) == "number" then r.LayoutOrder = n end end,
					Get = function() return Color3.fromHSV(h, s, v) end,
					Set = function(c)
						if typeof(c) ~= "Color3" then return end
						h, s, v = c:ToHSV()
						hueK.Position = UDim2.fromScale(h, 0.5)
						satK.Position = UDim2.fromScale(s, 0.5)
						valK.Position = UDim2.fromScale(v, 0.5)
						apply()
					end,
				}
				regCtl(sid, t, "color", obj.Get, obj.Set)
				return obj
			end

