			sPack:AddDropdown("Theme Pack (color + background)", { "Blood", "Ocean", "Sakura", "Matrix", "GoldBlack", "NeonPurple", "Forest", "Sunset", "Ice", "Royal", "Coffee", "Snow" }, "Sec", function(o)
				local p = PACKS[o]
				if not p then return end
				Aurora:SetAccent(p[1], true)
				applyBG(p[2])
			end)
			sPack:AddDropdown("Background Preset", BGORDER, "Sec", function(o) applyBG(o) end)
		end

		if opts.IncludeThemeBackgrounds ~= false then
			local sThemeBg = Settings:AddSection("Theme Backgrounds", true)
			sections.ThemeBackgrounds = sThemeBg
			sThemeBg:AddColorPicker("Background 0 (Top)", T.bg0, function(c) Aurora:UpdateThemeColor("bg0", c) end)
			sThemeBg:AddColorPicker("Background 1 (Bottom)", T.bg1, function(c) Aurora:UpdateThemeColor("bg1", c) end)
			sThemeBg:AddColorPicker("Sidebar Color", T.side, function(c) Aurora:UpdateThemeColor("side", c) end)
			sThemeBg:AddColorPicker("Card Color", T.card, function(c) Aurora:UpdateThemeColor("card", c) end)
			sThemeBg:AddColorPicker("Row Color", T.row, function(c) Aurora:UpdateThemeColor("row", c) end)
			sThemeBg:AddColorPicker("Row 2 Color", T.row2, function(c) Aurora:UpdateThemeColor("row2", c) end)
			sThemeBg:AddColorPicker("Line / Border Color", T.line, function(c) Aurora:UpdateThemeColor("line", c) end)
			sThemeBg:AddColorPicker("Text Color", T.text, function(c) Aurora:UpdateThemeColor("text", c) end)
			sThemeBg:AddColorPicker("Sub Text Color", T.sub, function(c) Aurora:UpdateThemeColor("sub", c) end)
			sThemeBg:AddColorPicker("Dim Text Color", T.dim, function(c) Aurora:UpdateThemeColor("dim", c) end)
			sThemeBg:AddColorPicker("Scrollbar Color", T.scroll, function(c) Aurora:UpdateThemeColor("scroll", c) end)
		end

		if opts.IncludeConfig ~= false then
			local sCfg = Settings:AddSection("Config")
			sections.Config = sCfg
			local HttpService = game:GetService("HttpService")
			local FILE = cfgFile
			local canFile = type(writefile) == "function" and type(readfile) == "function"
			local store = { profiles = {}, last = nil, ask = true }
			local THEME_KEYS = { "bg0", "bg1", "side", "card", "row", "row2", "line", "text", "sub", "dim", "scroll" }
			local WHITE = Color3.new(1, 1, 1)

			local function lbl(p)
				p.BackgroundTransparency = 1
				p.Font = p.Font or Enum.Font.GothamMedium
				p.TextSize = p.TextSize or 13
				p.TextColor3 = p.TextColor3 or T.text
				p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
				local srcText = p.Text
				p.Text = T_(srcText)
				local l = new("TextLabel", p)
				regT(l, srcText)
				return l
			end

			if canFile then
				pcall(function()
					if type(isfile) == "function" and isfile(FILE) then
						local d = HttpService:JSONDecode(readfile(FILE))
						if type(d) == "table" then
							if type(d.profiles) == "table" then store.profiles = d.profiles end
							if type(d.last) == "string" then store.last = d.last end
							if d.ask == false then store.ask = false end
						end
					end
				end)
			end
			local warnedNoFile = false
			local function writeStore()
				if not canFile then
					if not warnedNoFile then
						warnedNoFile = true
						Aurora:Notify("Config", "No file system: saves last only for this session.", 5, "warn")
					end
					return false
				end
				return pcall(function()
					writefile(FILE, HttpService:JSONEncode({ profiles = store.profiles, last = store.last, ask = store.ask }))
				end)
			end

			local function colSer(c) return { r = c.R, g = c.G, b = c.B } end
			local function colDeser(t)
				if type(t) == "table" and t.r and t.g and t.b then return Color3.new(t.r, t.g, t.b) end
				return nil
			end
			local function ser(kind, v)
				if kind == "color" then return colSer(v) end
				if kind == "keybind" then
					if typeof(v) == "EnumItem" then
						return { kind = (v.EnumType == Enum.UserInputType) and "mouse" or "key", name = v.Name }
					elseif type(v) == "table" and v.value then
						return { kind = v.kind, name = v.value.Name }
					end
					return nil
				end
				return v
			end
			local function deser(kind, v)
				if kind == "color" then return colDeser(v) end
				if kind == "keybind" then
					if type(v) == "table" and v.name then
						local ok, e = pcall(function()
							if v.kind == "mouse" then return Enum.UserInputType[v.name] end
							return Enum.KeyCode[v.name]
						end)
						if ok and e then return { kind = v.kind, value = e } end
					end
					return nil
				end
				return v
			end

			local function captureTheme()
				local th = { accent = colSer(savedAccent), keys = {} }
				for _, k in ipairs(THEME_KEYS) do th.keys[k] = colSer(T[k]) end
				return th
			end
			local function applyTheme(th)
				if type(th) ~= "table" then return end
				local a = colDeser(th.accent)
				if a then Aurora:SetAccent(a, true) end
				if type(th.keys) == "table" then
					for _, k in ipairs(THEME_KEYS) do
						local c = colDeser(th.keys[k])
						if c then Aurora:UpdateThemeColor(k, c) end
					end
				end
			end

			local function capture()
				local items, on = {}, 0
				for _, e in ipairs(CTL.list) do
					local ok, v = pcall(e.get)
					if ok and v ~= nil then
						local sv = ser(e.kind, v)
						if sv ~= nil then
							table.insert(items, { k = e.key, v = sv })
							if e.kind == "toggle" and v == true then on = on + 1 end
						end
					end
				end
				return items, on
			end

			local function keepForeign(items, old)
				if type(old) ~= "table" or type(old.items) ~= "table" then return items end
				for _, it in ipairs(old.items) do
					if type(it) == "table" and it.k and not CTL.map[it.k] then table.insert(items, it) end
				end
				return items
			end

			local applying = false
			local function applyProfile(name)
				local prof = store.profiles[name]
				if not prof or applying then return end
				applying = true
				task.spawn(function()
					pcall(applyTheme, prof.theme)
					local n, miss = 0, 0
					for i, it in ipairs(prof.items or {}) do
						local e = CTL.map[it.k]
						if e then
							local v = deser(e.kind, it.v)
							if v ~= nil and pcall(e.set, v) then n = n + 1 end
						else
							miss = miss + 1
						end
						if i % 10 == 0 then task.wait() end
					end
					applying = false
					store.last = name
					writeStore()
					Aurora:Notify("Config loaded", name .. " - " .. n .. T_(" settings applied") .. (miss > 0 and (" (" .. miss .. T_(" not in this game") .. ")") or ""), 3.5, "success")
				end)
			end

			local refresh
			local pendingRefresh = false
			local rowFrames = {}
			local selCfg = nil

			local function paintCfg()
				for _, rf in ipairs(rowFrames) do
					local st = rf.Parent and rf:FindFirstChildOfClass("UIStroke")
					if st then
						local on = selCfg == rf:GetAttribute("cfg")
						local last = rf:GetAttribute("last")
						tween(st, 0.18, { Color = (on or last) and accent or T.line, Transparency = on and 0 or (last and 0.35 or 0.55), Thickness = on and 2 or 1 })
					end
				end
			end

			local function makeRow(i, name, prof)
				local isLast = name == store.last
				local r = new("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = T.row, BorderSizePixel = 0, LayoutOrder = i }, { corner(12), stroke(isLast and accent or T.line, 1, isLast and 0.35 or 0.55) })
				r:SetAttribute("cfg", name)
				r:SetAttribute("last", isLast)
				table.insert(rowFrames, r)
				local pick = new("TextButton", { Text = "", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 1 })
				pick.MouseButton1Click:Connect(function()
					if selCfg == name then selCfg = nil else selCfg = name end
					paintCfg()
				end)
				pick.Parent = r

				local ic = new("Frame", { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(12, 12), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(12) })
				accentGrad(ic, 45)
				new("Frame", { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(4) }).Parent = ic
				new("Frame", { Size = UDim2.fromOffset(11, 6), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, -10), BackgroundColor3 = T.bg0, BorderSizePixel = 0, ZIndex = 2 }, { corner(2) }).Parent = ic
				new("Frame", { Size = UDim2.fromOffset(11, 6), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.5, 8), BackgroundColor3 = T.bg0, BorderSizePixel = 0, ZIndex = 2 }, { corner(2) }).Parent = ic
				ic.Parent = r

				lbl({ Text = name, Font = Enum.Font.GothamBold, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -190, 0, 20), Position = UDim2.fromOffset(62, 12) }).Parent = r
				lbl({
					Text = string.format("%d settings - %d on - %s", prof.n or 0, prof.on or 0, os.date("%d.%m %H:%M", prof.saved or os.time())),
					TextSize = 11, TextColor3 = T.dim, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -190, 0, 16), Position = UDim2.fromOffset(62, 34),
				}).Parent = r

				local load = new("TextButton", { Text = "", Size = UDim2.fromOffset(58, 28), Position = UDim2.new(1, -130, 0.5, -14), BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 3 }, { corner(10) })
				local loadFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 1 }, { corner(10) })
				accentGrad(loadFill, 0)
				loadFill.Parent = load
				lbl({ Text = "LOAD", Font = Enum.Font.GothamBlack, TextSize = 11, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 3 }).Parent = load
				load.Parent = r
				load.MouseButton1Click:Connect(function() applyProfile(name) end)

				local del = new("TextButton", { Text = "DELETE", Size = UDim2.fromOffset(58, 28), Position = UDim2.new(1, -68, 0.5, -14), BackgroundColor3 = T.row2, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = T.err, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 3 }, { corner(10), stroke(T.err, 1, 0.6) })
				del.Parent = r
				local armed = false
				del.MouseButton1Click:Connect(function()
					if not armed then
						armed = true
						del.Text = "SURE?"
						tween(del, 0.15, { BackgroundColor3 = T.err, TextColor3 = WHITE })
						task.delay(2, function()
							if armed and del.Parent then
								armed = false
								del.Text = "DELETE"
								tween(del, 0.15, { BackgroundColor3 = T.row2, TextColor3 = T.err })
							end
						end)
						return
					end
					armed = false
					store.profiles[name] = nil
					if store.last == name then
						local best, bt
						for n2, p2 in pairs(store.profiles) do
							if not bt or (p2.saved or 0) > bt then best, bt = n2, (p2.saved or 0) end
						end
						store.last = best
					end
					writeStore()
					Aurora:Notify("Config deleted", name, 3, "warn")
					refresh()
				end)
				return r
			end

			local nameText = ""
			sCfg:AddTextbox("Config name", "e.g. ESP on", function(txt) nameText = txt or "" end)
			sCfg:AddButton("Save Current UI", function()
				local nm = string.sub((nameText:gsub("^%s+", ""):gsub("%s+$", "")), 1, 24)
				if nm == "" then
					local c = 0
					for _ in pairs(store.profiles) do c = c + 1 end
					nm = "Config " .. (c + 1)
				end
				local items, on = capture()
				items = keepForeign(items, store.profiles[nm])
				store.profiles[nm] = { saved = os.time(), items = items, on = on, n = #items, theme = captureTheme() }
				store.last = nm
				writeStore()
				Aurora:Notify("Config saved", nm .. " - " .. #items .. T_(" settings, ") .. on .. T_(" features on"), 3.5, "success")
				refresh()
			end)
			local owArm, owTok = nil, 0
			sCfg:AddButton("Overwrite Selected Config", function()
				local nm = selCfg
				if not nm or not store.profiles[nm] then
					Aurora:Notify("Config", "Select a config from the list first", 3, "warn")
					return
				end
				if owArm ~= nm then
					owArm = nm
					owTok = owTok + 1
					local my = owTok
					Aurora:Notify("Are you sure?", nm .. " - press again to confirm", 4, "warn")
					task.delay(4, function() if owTok == my then owArm = nil end end)
					return
				end
				owArm = nil
				owTok = owTok + 1
				local items, on = capture()
				items = keepForeign(items, store.profiles[nm])
				store.profiles[nm] = { saved = os.time(), items = items, on = on, n = #items, theme = captureTheme() }
				store.last = nm
				writeStore()
				Aurora:Notify("Config updated", nm .. " - " .. #items .. T_(" settings, ") .. on .. T_(" features on"), 3.5, "success")
				refresh()
			end)
			sCfg:AddButton("Load Last Config", function()
				if store.last and store.profiles[store.last] then
					applyProfile(store.last)
				else
					Aurora:Notify("Config", "No saved config.", 3, "warn")
				end
			end)
			local askToggle = sCfg:AddToggle("Ask to load on open", store.ask, function(on)
				store.ask = on
				writeStore()
			end)
			local cont = sCfg:AddContainer()
			local head = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = T.row, BorderSizePixel = 0, AutoButtonColor = false, LayoutOrder = 0 }, { corner(10), stroke(T.line, 1, 0.5) })
			onThemeChange(function(k, c) if k == "row" then head.BackgroundColor3 = c end end)
			lbl({ Text = "Saved Configs", Font = Enum.Font.GothamBold, TextSize = 13, Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(14, 0) }).Parent = head
			local countPill = new("Frame", { Size = UDim2.fromOffset(34, 22), Position = UDim2.new(1, -76, 0.5, -11), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(11) })
			accentGrad(countPill, 0)
			local countL = lbl({ Text = "0", Font = Enum.Font.GothamBlack, TextSize = 12, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 2 })
			countL.Parent = countPill
			countPill.Parent = head
			local arrowL = lbl({ Text = "v", TextSize = 13, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(30, 42), Position = UDim2.new(1, -38, 0, 0) })
			arrowL.Parent = head
			head.Parent = cont
			local listBox = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Visible = false }, { list(6) })
			listBox.Parent = cont
			local listOpen = false
			head.MouseButton1Click:Connect(function()
				listOpen = not listOpen
				listBox.Visible = listOpen
				tween(arrowL, 0.2, { Rotation = listOpen and 180 or 0 })
			end)

			onThemeChange(function(k)
				if k == "row" or k == "text" or k == "sub" or k == "dim" or k == "bg0" or k == "err" then
					if pendingRefresh then return end
					pendingRefresh = true
					task.delay(0.2, function()
						pendingRefresh = false
						if refresh and listBox.Parent then refresh() end
					end)
				end
			end)

			refresh = function()
				for _, ch in ipairs(listBox:GetChildren()) do
					if ch:IsA("GuiObject") then ch:Destroy() end
				end
				rowFrames = {}
				local names = {}
				for n in pairs(store.profiles) do table.insert(names, n) end
				table.sort(names, function(a, b) return (store.profiles[a].saved or 0) > (store.profiles[b].saved or 0) end)
				countL.Text = tostring(#names)
				if #names == 0 then
					lbl({ Text = T_("No saved config yet. Turn on some features (e.g. ESP), type a name and press 'Save Current UI'."), TextSize = 11, TextColor3 = T.dim, TextWrapped = true, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 0) }).Parent = listBox
					return
				end
				for i, n in ipairs(names) do
					local rf = makeRow(i, n, store.profiles[n])
					rf.Parent = listBox
				end
				if selCfg and not store.profiles[selCfg] then selCfg = nil end
				paintCfg()
			end
			refresh()

			local function showPrompt(name)
				local prof = store.profiles[name]
				if not prof or not gui.Parent then return end
				local cam = workspace.CurrentCamera
				local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
				local fit = math.clamp(math.min((vp.X - 24) / 350, (vp.Y - 24) / 290), 0.5, 1)

				local overlay = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 200 })
				overlay.Parent = gui
				tween(overlay, 0.3, { BackgroundTransparency = 0.5 })

				local card = new("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(350, 272), BackgroundColor3 = T.bg0, BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 201 }, { corner(20), stroke(accent, 1.6, 0.15) })
				local cs = new("UIScale", { Scale = fit * 0.85 })
				cs.Parent = card

				local band = new("Frame", { Size = UDim2.new(1, 0, 0, 92), BackgroundColor3 = WHITE, BorderSizePixel = 0 })
				accentGrad(band, 25)
				new("Frame", { Size = UDim2.fromOffset(130, 130), Position = UDim2.fromOffset(-34, -56), BackgroundColor3 = WHITE, BackgroundTransparency = 0.88, BorderSizePixel = 0 }, { corner(65) }).Parent = band
				new("Frame", { Size = UDim2.fromOffset(96, 96), Position = UDim2.new(1, -64, 0, 26), BackgroundColor3 = WHITE, BackgroundTransparency = 0.9, BorderSizePixel = 0 }, { corner(48) }).Parent = band
				local icw = new("Frame", { Size = UDim2.fromOffset(60, 60), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = WHITE, BackgroundTransparency = 0.8, BorderSizePixel = 0 }, { corner(19), stroke(WHITE, 1.5, 0.5) })
				new("Frame", { Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(6) }).Parent = icw
				new("Frame", { Size = UDim2.fromOffset(16, 9), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, -15), BackgroundColor3 = T.bg0, BorderSizePixel = 0, ZIndex = 2 }, { corner(3) }).Parent = icw
				new("Frame", { Size = UDim2.fromOffset(16, 9), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.5, 12), BackgroundColor3 = T.bg0, BorderSizePixel = 0, ZIndex = 2 }, { corner(3) }).Parent = icw
				icw.Parent = band
				band.Parent = card

				lbl({ Text = "SAVED CONFIG FOUND", Font = Enum.Font.GothamBlack, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 104) }).Parent = card
				lbl({ Text = "Do you want to load this config now?", TextSize = 12, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -24, 0, 16), Position = UDim2.fromOffset(12, 127) }).Parent = card

				local chip = new("Frame", { Size = UDim2.new(1, -40, 0, 50), Position = UDim2.fromOffset(20, 152), BackgroundColor3 = T.row, BorderSizePixel = 0 }, { corner(12), stroke(T.line, 1, 0.4) })
				local dot = new("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(14, 21), BackgroundColor3 = accent, BorderSizePixel = 0 }, { corner(4) })
				dot.Parent = chip
				lbl({ Text = name, Font = Enum.Font.GothamBold, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -46, 0, 18), Position = UDim2.fromOffset(32, 8) }).Parent = chip
				lbl({ Text = string.format("%d settings - %d on - %s", prof.n or 0, prof.on or 0, os.date("%d.%m %H:%M", prof.saved or os.time())), TextSize = 11, TextColor3 = T.dim, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -46, 0, 16), Position = UDim2.fromOffset(32, 27) }).Parent = chip
				chip.Parent = card

				local closed = false
				local function close(after)
					if closed then return end
					closed = true
					tween(cs, 0.2, { Scale = fit * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
					tween(card, 0.2, { GroupTransparency = 1 })
					tween(overlay, 0.25, { BackgroundTransparency = 1 })
					task.delay(0.28, function()
						card:Destroy()
						overlay:Destroy()
						if after then after() end
					end)
				end

				local function mkBtn(text, x, primary, cb)
					local b = new("TextButton", {
						Text = "", Size = UDim2.fromOffset(150, 38), Position = UDim2.fromOffset(x, 214),
						AutoButtonColor = false, BorderSizePixel = 0, BackgroundTransparency = 1,
					}, { corner(12) })
					local bs = new("UIScale", { Scale = 1 })
					bs.Parent = b
					local txt = lbl({ Text = text, Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 3 })
					local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 1 }, { corner(12) })
					accentGrad(fill, 0)
					fill.Parent = b
					txt.Parent = b
					b.MouseEnter:Connect(function() tween(bs, 0.12, { Scale = 1.05 }) end)
					b.MouseLeave:Connect(function() tween(bs, 0.12, { Scale = 1 }) end)
					b.MouseButton1Click:Connect(cb)
					b.Parent = card
				end
				mkBtn(T_("YES, LOAD"), 20, true, function() close(function() applyProfile(name) end) end)
				mkBtn(T_("NO"), 180, false, function() close() end)

				local never = new("TextButton", { Text = T_("Don't ask again"), Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 254), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = T.dim, AutoButtonColor = false })
				never.MouseEnter:Connect(function() tween(never, 0.15, { TextColor3 = T.text }) end)
				never.MouseLeave:Connect(function() tween(never, 0.15, { TextColor3 = T.dim }) end)
				never.MouseButton1Click:Connect(function()
					askToggle.Set(false)
					Aurora:Notify("Config", "Ask-on-open is off. You can turn it on again in Settings > Config.", 4)
					close()
				end)
				never.Parent = card

				card.Parent = gui
				tween(cs, 0.45, { Scale = fit }, Enum.EasingStyle.Back)
				tween(card, 0.3, { GroupTransparency = 0 })
			end

			Window.AfterOpen = function()
				if not store.ask then return end
				local n = store.last
				if not n or not store.profiles[n] then return end
				task.wait(0.45)
				showPrompt(n)
			end
		end

		return Settings, sections
	end
	Window.CreateSettingsTab = Window.AddSettingsTab

	return Window
end


