			local gPlayers = kv(gc, 132, "Players", "")
			kv(gc, 150, "Version", game.PlaceVersion)

			local frames, last = 0, os.clock()
			table.insert(conns, RunService.RenderStepped:Connect(function()
				frames = frames + 1
				local n = os.clock()
				if n - last < 0.5 then return end
				local fps = frames / (n - last)
				frames, last = 0, n
				setFps(string.format("%d", math.floor(fps + 0.5)), "frames per second", fps / 60)
				local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
				if ok then
					setPing(string.format("%d ms", math.floor(p + 0.5)), "server latency", 1 - p / 300)
				else
					setPing("-- ms", "server latency", 0)
				end
				local count, max = #Players:GetPlayers(), Players.MaxPlayers
				setPlayers(tostring(count), "of " .. max .. " slots", count / math.max(1, max))
				gPlayers.Text = count .. " / " .. max
			end))
		end

